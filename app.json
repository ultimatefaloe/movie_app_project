{
  "expo": {
    "name": "Movie App Project",
    "slug": "movie_app_project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/self/icon.png",
    "scheme": "movieappproject",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/self/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/self/icon.png",
        "backgroundImage": "./assets/self/background.png",
        "monochromeImage": "./assets/self/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/self/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/self/splash-screen.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
